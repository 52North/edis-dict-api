# default configuration, copy to .env for local use
PORT=3000
STATIONS_FILE_PATH=stations.json
EINZUGSGEBIETE_FILE_PATH=einzugsgebiete.geojson
SUCHWORTLISTE_FILE_PATH=Suchwortliste-Dict-API_v0-1_2022-06-23.xlsx
PEGELONLINE_BASE_URL=https://www.pegelonline.wsv.de/webservices/rest-api/v2
MQTT_BASE=edis/pegelonline
NOMINATIM_BASE_URL=http://localhost:9090/
CRON_TIME_FOR_DATA_ENLARGING=00 00 * * *
RUN_DATA_ENLARGING_ON_INIT=true
ADDITIONAL_HARVEST_LANGUAGE_LIST=en,da,pl,cs,de-AT,de-CH,fr,lb,nl
# maximum concurrent outgoing http connections for harvesting the data
MAX_REQUESTS_COUNT=5
# optional Sensor Web API (Dataset API v3, e.g. gdi-sos) for the download links of the timeseries, leave empty for none
SENSORWEB_API_URL=https://test.sensor-gdi.de/webservices/gis/gdi-sos/api/
# optional proxy for PEGELONLINE and the Sensor Web API, used only if all three are set (no authentication)
#PROXY_PROTOCOL=http
#PROXY_HOST=
#PROXY_PORT=
